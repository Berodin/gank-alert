# Region for the desktop client's feed (api's GET /feed). Not used by the
# ingester (which now watches all regions) or the bot (region is chosen
# per-Discord-server with the /setregion command). Default 10000002 = The
# Forge (Jita).
GANK_REGION_ID=10000002

# Discord bot (create at https://discord.com/developers/applications, needs
# the `applications.commands` OAuth2 scope when generating the invite link
# so /setregion is available). No channel ID here -- each server sets its
# own with /setregion.
DISCORD_BOT_TOKEN=

# EVE SSO app (create at https://developers.eveonline.com, PUBLIC client type for PKCE)
GANK_EVE_CLIENT_ID=
GANK_EVE_REDIRECT_URI=https://gank.example.com/auth/eve/callback
GANK_API_DOMAIN=gank.example.com
